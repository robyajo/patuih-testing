# Patuih Chat — Environment Configuration
# Copy this file to .env and adjust values

# Patuih API (backend) — URL where Patuih BE runs
VITE_PATUIH_URL=http://localhost:8000

# Webhook Tester (APP-TESTING server) — URL where the tester runs
# This receives webhooks and broadcasts messages via Socket.IO
VITE_TESTER_URL=http://localhost:3099

# WebSocket URL — leave empty to use VITE_TESTER_URL
VITE_WS_URL=

# API Base URL — where the APP-TESTING server runs
VITE_API_BASE=http://localhost:3099
